# Balance the tiled Attention lanes across the U50 SLRs and keep every lane's
# K/V AXI adapters beside the lane that consumes them.  Both the legacy
# lane-local cache hierarchy and the exact physical-prefix hierarchy are
# generated by the selected HLS source, depending on its compile-time mode.

proc fpt26_require_one {objects description} {
  if {[llength $objects] != 1} {
    error "FPT26 tiled floorplan expected exactly one $description, found [llength $objects]"
  }
  return [lindex $objects 0]
}

set slr0_pblock [fpt26_require_one \
  [get_pblocks -quiet pblock_dynamic_SLR0] \
  "pblock_dynamic_SLR0"]
set slr1_pblock [fpt26_require_one \
  [get_pblocks -quiet pblock_dynamic_SLR1] \
  "pblock_dynamic_SLR1"]
set authoritative_dataflows [get_cells -quiet -hierarchical -regexp \
  {.*/grp_p_anonymous_namespace_run_tile_authoritative_semantic_kv_fu_[0-9]+$}]
if {[llength $authoritative_dataflows] == 1} {
  set dataflow [lindex $authoritative_dataflows 0]
  set authoritative_semantic 1
  set physical_prefix 0
} elseif {[llength $authoritative_dataflows] > 1} {
  error "FPT26 tiled floorplan expected at most one authoritative-semantic Attention dataflow hierarchy, found [llength $authoritative_dataflows]"
} else {
  set authoritative_semantic 0
  set physical_dataflows [get_cells -quiet -hierarchical -regexp \
    {.*/grp_p_anonymous_namespace_run_tile_physical_prefix_fu_[0-9]+$}]
  if {[llength $physical_dataflows] == 1} {
    set dataflow [lindex $physical_dataflows 0]
    set physical_prefix 1
  } elseif {[llength $physical_dataflows] > 1} {
    error "FPT26 tiled floorplan expected at most one physical-prefix Attention dataflow hierarchy, found [llength $physical_dataflows]"
  } else {
    set dataflow [fpt26_require_one \
      [get_cells -quiet -hierarchical -regexp \
        {.*/grp_p_anonymous_namespace_run_tile_fu_[0-9]+$}] \
      "tiled Attention dataflow hierarchy"]
    set physical_prefix 0
  }
}
set dataflow_name [get_property NAME $dataflow]
set kernel_name [file dirname $dataflow_name]

if {$authoritative_semantic} {
  set authoritative_back [fpt26_require_one \
    [get_cells -quiet -hierarchical -regexp \
      [format {^%s/p_anonymous_namespace_run_all_lane_back_shared_normalize_074_U0$} \
        $dataflow_name]] \
    "shared-normalizer lane-back hierarchy"]
  set authoritative_back_name [get_property NAME $authoritative_back]

  set authoritative_accumulate_base [fpt26_require_one \
    [get_cells -quiet -hierarchical -regexp \
      [format {^%s/fattn_accumulate_values_bounded_prefetch_U0$} \
        $authoritative_back_name]] \
    "lane 0 SV accumulator hierarchy"]
  set authoritative_accumulate_numbered [lsort -dictionary \
    [get_cells -quiet -hierarchical -regexp \
      [format {^%s/fattn_accumulate_values_bounded_prefetch_[0-9]+_U0$} \
        $authoritative_back_name]]]
  if {[llength $authoritative_accumulate_numbered] != 3} {
    error "FPT26 tiled floorplan expected three numbered SV accumulator hierarchies, found [llength $authoritative_accumulate_numbered]"
  }
  set authoritative_accumulate_cells \
    [linsert $authoritative_accumulate_numbered 0 \
      $authoritative_accumulate_base]

  set authoritative_store_base [fpt26_require_one \
    [get_cells -quiet -hierarchical -regexp \
      [format {^%s/p_anonymous_namespace_store_output_from_addresses_071_U0$} \
        $authoritative_back_name]] \
    "lane 0 output-store hierarchy"]
  set authoritative_store_numbered [lsort -dictionary \
    [get_cells -quiet -hierarchical -regexp \
      [format {^%s/p_anonymous_namespace_store_output_from_addresses_071_[0-9]+_U0$} \
        $authoritative_back_name]]]
  if {[llength $authoritative_store_numbered] != 3} {
    error "FPT26 tiled floorplan expected three numbered output-store hierarchies, found [llength $authoritative_store_numbered]"
  }
  set authoritative_store_cells \
    [linsert $authoritative_store_numbered 0 $authoritative_store_base]
} else {
  if {$physical_prefix} {
    set lane_back_base_pattern \
      [format {^%s/p_anonymous_namespace_run_lane_back_physical_prefix_U0$} \
        $dataflow_name]
    set lane_back_numbered_pattern \
      [format {^%s/p_anonymous_namespace_run_lane_back_physical_prefix_[0-9]+_U0$} \
        $dataflow_name]
  } else {
    set lane_back_base_pattern \
      [format {^%s/p_anonymous_namespace_run_lane_back_U0$} $dataflow_name]
    set lane_back_numbered_pattern \
      [format {^%s/p_anonymous_namespace_run_lane_back_[0-9]+_U0$} \
        $dataflow_name]
  }
  set lane_back_base [fpt26_require_one \
    [get_cells -quiet -hierarchical -regexp $lane_back_base_pattern] \
    "lane 0 back hierarchy"]
  set lane_back_numbered [lsort -dictionary \
    [get_cells -quiet -hierarchical -regexp $lane_back_numbered_pattern]]
  if {[llength $lane_back_numbered] != 3} {
    error "FPT26 tiled floorplan expected three numbered lane-back hierarchies, found [llength $lane_back_numbered]"
  }
  set lane_back_cells [linsert $lane_back_numbered 0 $lane_back_base]
}

proc fpt26_dataflow_cell {dataflow_name suffix description} {
  return [fpt26_require_one \
    [get_cells -quiet -hierarchical -regexp "^${dataflow_name}/${suffix}$"] \
    $description]
}

proc fpt26_kernel_cell {kernel_name suffix description} {
  return [fpt26_require_one \
    [get_cells -quiet -hierarchical -regexp "^${kernel_name}/${suffix}$"] \
    $description]
}

proc fpt26_authoritative_lane_cells {dataflow_name kernel_name lane} {
  global authoritative_back_name
  global authoritative_accumulate_cells
  global authoritative_store_cells

  set cells [list \
    [fpt26_dataflow_cell $dataflow_name \
      "p_anonymous_namespace_run_lane_front_address_token_071_${lane}_U0" \
      "lane ${lane} address-token front hierarchy"] \
    [fpt26_dataflow_cell $dataflow_name \
      "fattn_stream_authoritative_semantic_dual_phase_066_${lane}_U0" \
      "lane ${lane} authoritative semantic K/V actor"] \
    [lindex $authoritative_accumulate_cells $lane] \
    [lindex $authoritative_store_cells $lane] \
    [fpt26_kernel_cell $kernel_name \
      "gmem_qo${lane}_m_axi_U" \
      "lane ${lane} Q/output AXI adapter"] \
    [fpt26_kernel_cell $kernel_name \
      "gmem_k${lane}_m_axi_U" \
      "lane ${lane} K AXI adapter"] \
    [fpt26_kernel_cell $kernel_name \
      "gmem_v${lane}_m_axi_U" \
      "lane ${lane} V AXI adapter"] \
    [fpt26_require_one \
      [get_cells -quiet -hierarchical -regexp \
        [format {^%s/accumulators%d_U$} \
          $authoritative_back_name $lane]] \
      "lane ${lane} SV accumulator stream"] \
    [fpt26_require_one \
      [get_cells -quiet -hierarchical -regexp \
        [format {^%s/normalized%d_U$} \
          $authoritative_back_name $lane]] \
      "lane ${lane} normalized-output stream"]]

  if {$lane == 0} {
    set lane_suffix ""
  } else {
    set lane_suffix "_${lane}"
  }
  foreach base {
    active_keys active_values keys values scores scales denominators
    query_addresses_071 output_addresses_071
  } {
    lappend cells [fpt26_dataflow_cell $dataflow_name \
      "${base}${lane_suffix}_U" \
      "lane ${lane} ${base} stream"]
  }
  return $cells
}

proc fpt26_lane_cells {dataflow_name kernel_name lane physical_prefix} {
  global lane_back_cells
  if {$physical_prefix} {
    set front_suffix \
      "p_anonymous_namespace_run_lane_front_physical_prefix_${lane}_U0"
    set fifo_bases [list scores scales denominators]
    set cells [list \
      [fpt26_dataflow_cell $dataflow_name $front_suffix \
        "lane ${lane} physical-prefix front hierarchy"] \
      [lindex $lane_back_cells $lane] \
      [fpt26_kernel_cell $kernel_name \
        "gmem_qo${lane}_m_axi_U" \
        "lane ${lane} Q/output AXI adapter"] \
      [fpt26_kernel_cell $kernel_name \
        "gmem_k${lane}_m_axi_U" \
        "lane ${lane} K AXI adapter"] \
      [fpt26_kernel_cell $kernel_name \
        "gmem_v${lane}_m_axi_U" \
        "lane ${lane} V AXI adapter"]]
  } else {
    set fifo_bases [list even odd values scores scales denominators]
    set cells [list \
      [fpt26_dataflow_cell $dataflow_name \
        "p_anonymous_namespace_run_lane_front_${lane}_U0" \
        "lane ${lane} front hierarchy"] \
      [lindex $lane_back_cells $lane] \
      [fpt26_kernel_cell $kernel_name \
        "gmem_qo${lane}_m_axi_U" \
        "lane ${lane} Q/output AXI adapter"] \
      [fpt26_kernel_cell $kernel_name \
        "gmem_kv${lane}_m_axi_U" \
        "lane ${lane} persistent-cache AXI adapter"]]
  }

  if {$lane == 0} {
    set lane_suffix ""
  } else {
    set lane_suffix "_${lane}"
  }
  foreach base $fifo_bases {
    lappend cells [fpt26_dataflow_cell $dataflow_name \
      "${base}${lane_suffix}_U" \
      "lane ${lane} ${base} stream"]
  }
  return $cells
}

set slr0_cells {}
set slr1_cells {}
foreach lane {0 1} {
  if {$authoritative_semantic} {
    set lane_cells \
      [fpt26_authoritative_lane_cells $dataflow_name $kernel_name $lane]
  } else {
    set lane_cells \
      [fpt26_lane_cells $dataflow_name $kernel_name $lane $physical_prefix]
  }
  set slr0_cells [concat $slr0_cells $lane_cells]
}
foreach lane {2 3} {
  if {$authoritative_semantic} {
    set lane_cells \
      [fpt26_authoritative_lane_cells $dataflow_name $kernel_name $lane]
  } else {
    set lane_cells \
      [fpt26_lane_cells $dataflow_name $kernel_name $lane $physical_prefix]
  }
  set slr1_cells [concat $slr1_cells $lane_cells]
}

set slr0_cells [lsort -unique $slr0_cells]
set slr1_cells [lsort -unique $slr1_cells]
add_cells_to_pblock $slr0_pblock $slr0_cells
add_cells_to_pblock $slr1_pblock $slr1_cells

puts "FPT26 tiled lane-local-KV floorplan: dataflow=$dataflow_name authoritative_semantic=$authoritative_semantic"
puts "FPT26 tiled lane-local-KV floorplan: SLR0 lanes=0,1 cells=[llength $slr0_cells]"
puts "FPT26 tiled lane-local-KV floorplan: SLR1 lanes=2,3 cells=[llength $slr1_cells]"
